<%@ page pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Location de voitures</title>
    <link rel="icon" type="image/png" href="${pageContext.request.contextPath}/images/favicon.png">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
    <%-- Tailwind CSS : chargé depuis Internet, rien à installer --%>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800">

<%-- Style commun des liens du menu --%>
<c:set var="lien" value="rounded-md px-3 py-2 text-sm hover:bg-slate-700 hover:text-white"/>

<header class="bg-slate-900 text-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-3">
        <a href="${pageContext.request.contextPath}/accueil" class="flex items-center gap-2">
            <img src="${pageContext.request.contextPath}/images/logo.png" alt="AutoLocation" class="h-10 w-auto rounded-lg">
        </a>
        <nav class="flex flex-wrap items-center gap-1">
            <c:choose>
                <%-- Menu de l'administrateur --%>
                <c:when test="${sessionScope.authenticatedRole == 'ADMIN'}">
                    <a href="${pageContext.request.contextPath}/accueil" class="${lien} ${active == 'accueil' ? 'bg-slate-700 text-white' : 'text-slate-300'}">Tableau de bord</a>
                    <a href="${pageContext.request.contextPath}/vehicules" class="${lien} ${active == 'vehicules' ? 'bg-slate-700 text-white' : 'text-slate-300'}">Véhicules</a>
                    <a href="${pageContext.request.contextPath}/clients" class="${lien} ${active == 'clients' ? 'bg-slate-700 text-white' : 'text-slate-300'}">Clients</a>
                    <a href="${pageContext.request.contextPath}/contrats" class="${lien} ${active == 'contrats' ? 'bg-slate-700 text-white' : 'text-slate-300'}">Contrats</a>
                    <a href="${pageContext.request.contextPath}/admin/reservations" class="${lien} ${active == 'reservations' ? 'bg-slate-700 text-white' : 'text-slate-300'}">Réservations</a>
                </c:when>

                <%-- Menu du client connecté --%>
                <c:when test="${sessionScope.authenticatedRole == 'USER'}">
                    <a href="${pageContext.request.contextPath}/vehicules" class="${lien} ${active == 'vehicules' ? 'bg-slate-700 text-white' : 'text-slate-300'}">Véhicules</a>
                    <a href="${pageContext.request.contextPath}/mes-reservations" class="${lien} ${active == 'reservations' ? 'bg-slate-700 text-white' : 'text-slate-300'}">Mes réservations</a>
                </c:when>
            </c:choose>

            <%-- Connexion / déconnexion --%>
            <c:choose>
                <c:when test="${not empty sessionScope.authenticatedUserId}">
                    <details class="relative">
                        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-3 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white">
                            <span class="user-avatar">👤</span>
                            <span>Mon compte</span>
                            <span class="text-xs">▾</span>
                        </summary>
                        <div class="account-menu">
                            <a href="${pageContext.request.contextPath}/profile">Profil</a>
                            <a href="${pageContext.request.contextPath}/logout">Déconnexion</a>
                        </div>
                    </details>
                </c:when>
                <c:otherwise>
                    <a href="${pageContext.request.contextPath}/vehicules" class="${lien} text-slate-300">Véhicules</a>
                    <a href="${pageContext.request.contextPath}/mes-reservations" class="${lien} text-slate-300">Mes réservations</a>
                    <a href="${pageContext.request.contextPath}/login" class="${lien} ${active == 'login' ? 'bg-slate-700 text-white' : 'text-slate-300'}">Connexion</a>
                    <a href="${pageContext.request.contextPath}/register" class="rounded-md bg-sky-600 px-3 py-2 text-sm text-white hover:bg-sky-700">Inscription</a>
                </c:otherwise>
            </c:choose>
        </nav>
    </div>
</header>
<main class="mx-auto min-h-[70vh] max-w-6xl px-5 py-7">
    <c:if test="${not empty sessionScope.message}">
        <div class="mb-4 rounded-lg bg-emerald-100 px-4 py-3 text-emerald-800"><c:out value="${sessionScope.message}"/></div>
        <c:remove var="message" scope="session"/>
    </c:if>
    <c:if test="${not empty sessionScope.error}">
        <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800"><c:out value="${sessionScope.error}"/></div>
        <c:remove var="error" scope="session"/>
    </c:if>
    <c:if test="${not empty requestScope.error}">
        <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800"><c:out value="${requestScope.error}"/></div>
    </c:if>
